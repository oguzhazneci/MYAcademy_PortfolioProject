@model List<Skill>

@{
    ViewData["Title"] = "Yetenek Kategorileri";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
}

<main class="page-content-area">

    <div class="content-header-row">
        <div>
            <h1 class="page-title">Yetenek Kategorileri</h1>
            <p class="page-subtitle">Sitedeki Yetenekler bölümünde her kategori ayrı bir kart olarak görünür.</p>
        </div>
        <div class="header-actions">
            <a asp-controller="SkillItem" asp-action="SkillItemList" class="btn-pastel-secondary text-decoration-none">
                <i class="bi bi-list-check"></i>
                <span>Yetenekleri Yönet</span>
            </a>
            <a asp-action="CreateSkill" class="btn-pastel-primary text-decoration-none">
                <i class="bi bi-plus-circle-fill"></i>
                <span>Yeni Kategori Ekle</span>
            </a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Kapat"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Kapat"></button>
        </div>
    }

    <div class="data-table-card">
        <div class="table-responsive-wrapper">
            <table class="custom-admin-table">
                <thead>
                    <tr>
                        <th>İkon</th>
                        <th>Kategori</th>
                        <th>Açıklama</th>
                        <th>Yetenek Sayısı</th>
                        <th>İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="5" class="text-center text-muted py-4">Henüz kategori eklenmedi.</td>
                        </tr>
                    }

                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="fs-5"><i class="bi @item.IconUrl"></i></td>
                            <td class="fw-semibold">@item.Title</td>
                            <td class="text-muted small">@item.Description</td>
                            <td><span class="order-badge">@(item.SkillItems?.Count ?? 0)</span></td>
                            <td>
                                <div class="row-actions-group">
                                    <a asp-action="UpdateSkill" asp-route-id="@item.SkillId" class="btn-action-icon btn-edit" title="Güncelle">
                                        <i class="bi bi-pencil"></i>
                                    </a>

                                    @* Geçici onay: Aşama 9'da SweetAlert2 ile değiştirilecek. *@
                                    <form asp-action="DeleteSkill" asp-route-id="@item.SkillId" method="post" class="d-inline"
                                          onsubmit="return confirm('Bu kategoriyi silmek istediğinize emin misiniz?');">
                                        <button type="submit" class="btn-action-icon btn-delete" title="Sil">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

</main>