@model Project

@* enctype="multipart/form-data": form dosya gönderecekse ŞART. Olmazsa dosya sunucuya hiç ulaşmaz. *@
<form method="post" enctype="multipart/form-data">
    <input type="hidden" asp-for="ProjectId" />

    <div class="row">
        <div class="col-md-8 mb-3">
            <label asp-for="ProjectTitle" class="form-label">Proje Adı</label>
            <input asp-for="ProjectTitle" class="form-control" />
            <span asp-validation-for="ProjectTitle" class="text-danger small"></span>
        </div>
        <div class="col-md-4 mb-3">
            <label asp-for="CategoryId" class="form-label">Kategori</label>
            <select asp-for="CategoryId" asp-items="ViewBag.Categories" class="form-select">
                <option value="0">-- Kategori seçin --</option>
            </select>
            <span asp-validation-for="CategoryId" class="text-danger small"></span>
        </div>
    </div>

    <div class="mb-3">
        <label asp-for="Description" class="form-label">Açıklama</label>
        <textarea asp-for="Description" class="form-control" rows="4"></textarea>
        <span asp-validation-for="Description" class="text-danger small"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Technologies" class="form-label">Teknolojiler</label>
        <input asp-for="Technologies" class="form-control" placeholder="Örn: ASP.NET Core, EF Core, SQL Server" />
        <div class="form-text">Virgülle ayırın. Her biri sitede ayrı bir rozet olarak görünür.</div>
        <span asp-validation-for="Technologies" class="text-danger small"></span>
    </div>

    <div class="mb-3">
        <label for="imageFile" class="form-label">
            Proje Görseli
            @if (Model.ProjectId != 0)
            {
                <span class="text-muted">(değiştirmek istemiyorsanız boş bırakın)</span>
            }
        </label>
        <div class="d-flex align-items-start gap-3">
            @* Önizleme: güncellemede mevcut görsel, dosya seçilince seçilen görsel. *@
            <img id="imagePreview" src="@Model.ImageUrl" alt="Görsel önizlemesi"
                 class="rounded-3 border @(string.IsNullOrEmpty(Model.ImageUrl) ? "d-none" : "")"
                 style="width: 160px; height: 100px; object-fit: cover;" />
            <div class="flex-grow-1">
                <input type="file" id="imageFile" name="imageFile" class="form-control" accept=".jpg,.jpeg,.png,.webp" />
                <div class="form-text">JPG, PNG veya WEBP · en fazla 2 MB</div>
                @Html.ValidationMessage("imageFile", new { @class = "text-danger small" })
            </div>
        </div>
    </div>
    
    <div class="mb-3">
        <label asp-for="ProjectUrl" class="form-label">Proje Bağlantısı <span class="text-muted">(isteğe bağlı)</span></label>
        <input asp-for="ProjectUrl" class="form-control" placeholder="https://github.com/..." />
        <div class="form-text">Doluysa sitede "Projeyi İncele" butonu bu adrese gider.</div>
        <span asp-validation-for="ProjectUrl" class="text-danger small"></span>
    </div>

    <div class="form-check form-switch mb-4">
        <input asp-for="IsActive" class="form-check-input" role="switch" />
        <label asp-for="IsActive" class="form-check-label">Aktif (sitede gösterilsin)</label>
    </div>

    <div class="d-flex gap-2">
        <button type="submit" class="btn-pastel-primary">
            <i class="bi bi-save"></i>
            <span>Kaydet</span>
        </button>
        <a asp-action="ProjectList" class="btn-pastel-secondary text-decoration-none">
            <span>Vazgeç</span>
        </a>
    </div>
</form>
<script>
    // Dosya seçilir seçilmez, sunucuya göndermeden tarayıcıda önizleme gösterir.
    document.getElementById('imageFile').addEventListener('change', function () {
        const preview = document.getElementById('imagePreview');
        if (this.files && this.files[0]) {
            preview.src = URL.createObjectURL(this.files[0]);
            preview.classList.remove('d-none');
        }
    });
</script>