@model List<Category>

@{
    ViewData["Title"] = "Proje Kategorileri";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
}

<main class="page-content-area">

    <div class="content-header-row">
        <div>
            <h1 class="page-title">Proje Kategorileri</h1>
            <p class="page-subtitle">Projeleri gruplamak için kullanılan kategoriler. Sitede filtre butonu olarak görünürler.</p>
        </div>
        <div class="header-actions">
            <a asp-controller="Project" asp-action="ProjectList" class="btn-pastel-secondary text-decoration-none">
                <i class="bi bi-code-slash"></i>
                <span>Projeler</span>
            </a>
            <a asp-action="CreateCategory" class="btn-pastel-primary text-decoration-none">
                <i class="bi bi-plus-circle-fill"></i>
                <span>Yeni Kategori Ekle</span>
            </a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Kapat"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Kapat"></button>
        </div>
    }

    <div class="data-table-card">
        <div class="table-responsive-wrapper">
            <table class="custom-admin-table">
                <thead>
                    <tr>
                        <th>Kategori</th>
                        <th>Proje Sayısı</th>
                        <th style="text-align: right;">İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="3" class="text-center text-muted py-4">Henüz kategori eklenmedi.</td>
                        </tr>
                    }

                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="fw-semibold">@item.CategoryName</td>
                            <td><span class="order-badge">@(item.Projects?.Count ?? 0)</span></td>
                            <td>
                                <div class="row-actions-group justify-content-end">
                                    <a asp-action="UpdateCategory" asp-route-id="@item.CategoryId" class="btn-action-icon btn-edit" title="Güncelle">
                                        <i class="bi bi-pencil-square"></i>
                                    </a>

                                    <form asp-action="DeleteCategory" asp-route-id="@item.CategoryId" method="post" class="d-inline"
                                          onsubmit="return confirm('Bu kategoriyi silmek istediğinize emin misiniz?');">
                                        <button type="submit" class="btn-action-icon btn-delete" title="Sil">
                                            <i class="bi bi-trash3"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

</main>