@model Category

@{
    ViewData["Title"] = "Proje Kategorisini Güncelle";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
}

<main class="page-content-area">
    <div class="content-header-row">
        <div>
            <h1 class="page-title">Proje Kategorisini Güncelle</h1>
            <p class="page-subtitle">Kategorinin adını değiştirin.</p>
        </div>
    </div>

    <div class="data-table-card p-4" style="max-width: 640px;">
        <partial name="_CategoryForm" model="Model" />
    </div>
</main>