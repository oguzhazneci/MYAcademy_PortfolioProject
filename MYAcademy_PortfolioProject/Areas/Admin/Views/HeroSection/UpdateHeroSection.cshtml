@model HeroSection

@{
    ViewData["Title"] = "Ana Sayfa (Hero) Yönetimi";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
}

<main class="page-content-area">

    <div class="content-header-row">
        <div>
            <h1 class="page-title">Ana Sayfa (Hero) Yönetimi</h1>
            <p class="page-subtitle">Sitenin en üstünde görünen karşılama alanını buradan düzenleyebilirsiniz.</p>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Kapat"></button>
        </div>
    }

    <div class="data-table-card p-4">
        <form method="post">
            @* Id gizli alanda taşınır; böylece POST'ta hangi kaydın güncelleneceği bilinir. *@
            <input type="hidden" asp-for="HeroSectionId" />

            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="row g-4">
                <div class="col-lg-8">
                    <div class="mb-3">
                        <label asp-for="Greeting" class="form-label">Selamlama</label>
                        <input asp-for="Greeting" class="form-control" placeholder="Örn: Merhaba, ben Oğuz 👋" />
                        <span asp-validation-for="Greeting" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Title" class="form-label">Başlık</label>
                        <input asp-for="Title" class="form-control" />
                        <span asp-validation-for="Title" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Description" class="form-label">Açıklama</label>
                        <textarea asp-for="Description" class="form-control" rows="4"></textarea>
                        <span asp-validation-for="Description" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="MainImageUrl" class="form-label">Görsel Adresi (URL)</label>
                        <input asp-for="MainImageUrl" class="form-control" />
                        <span asp-validation-for="MainImageUrl" class="text-danger small"></span>
                    </div>

                    <button type="submit" class="btn-pastel-primary">
                        <i class="bi bi-save"></i>
                        <span>Kaydet</span>
                    </button>
                </div>

                <div class="col-lg-4">
                    <label class="form-label">Mevcut Görsel</label>
                    @if (!string.IsNullOrEmpty(Model.MainImageUrl))
                    {
                        <img src="@Model.MainImageUrl" alt="Hero görseli" class="img-fluid rounded-3 border" />
                    }
                    else
                    {
                        <div class="border rounded-3 p-4 text-center text-muted small">Henüz görsel eklenmedi.</div>
                    }
                </div>
            </div>
        </form>
    </div>

</main>