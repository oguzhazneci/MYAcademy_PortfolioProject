@model HeroSection

@{
    ViewData["Title"] = "Ana Sayfa (Hero) Yönetimi";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
}

<main class="page-content-area">

    <div class="content-header-row">
        <div>
            <h1 class="page-title">Ana Sayfa (Hero) Yönetimi</h1>
            <p class="page-subtitle">Sitenin en üstünde görünen karşılama alanını buradan düzenleyebilirsiniz.</p>
        </div>
    </div>

    <div class="data-table-card p-4">
        <form method="post" enctype="multipart/form-data">
            @* Id gizli alanda taşınır; böylece POST'ta hangi kaydın güncelleneceği bilinir. *@
            <input type="hidden" asp-for="HeroSectionId" />

            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="row g-4">
                <div class="col-lg-8">
                    <div class="mb-3">
                        <label asp-for="Greeting" class="form-label">Selamlama</label>
                        <input asp-for="Greeting" class="form-control" placeholder="Örn: Merhaba, ben Oğuz 👋" />
                        <span asp-validation-for="Greeting" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Title" class="form-label">Başlık</label>
                        <input asp-for="Title" class="form-control" />
                        <span asp-validation-for="Title" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Description" class="form-label">Açıklama</label>
                        <textarea asp-for="Description" class="form-control" rows="4"></textarea>
                        <span asp-validation-for="Description" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label for="imageFile" class="form-label">Görsel</label>
                        <input type="file" id="imageFile" name="imageFile" class="form-control" accept=".jpg,.jpeg,.png,.webp" />
                        <div class="form-text">JPG, PNG veya WEBP · en fazla 2 MB. Değiştirmek istemiyorsanız boş bırakın.</div>
                        @Html.ValidationMessage("imageFile", new { @class = "text-danger small" })
                    </div>

                    <button type="submit" class="btn-pastel-primary">
                        <i class="bi bi-save"></i>
                        <span>Kaydet</span>
                    </button>
                </div>

                <div class="col-lg-4">
                    <label class="form-label">Mevcut Görsel</label>
                    <img id="imagePreview" src="@Model.MainImageUrl" alt="Hero görseli"
                         class="img-fluid rounded-3 border @(string.IsNullOrEmpty(Model.MainImageUrl) ? "d-none" : "")" />
                    @if (string.IsNullOrEmpty(Model.MainImageUrl))
                    {
                        <div id="imagePlaceholder" class="border rounded-3 p-4 text-center text-muted small">Henüz görsel eklenmedi.</div>
                    }
                </div>
            </div>
        </form>
    </div>

</main>
<script>
    // Dosya seçilir seçilmez, sunucuya göndermeden tarayıcıda önizleme gösterir.
    document.getElementById('imageFile').addEventListener('change', function () {
        const preview = document.getElementById('imagePreview');
        const placeholder = document.getElementById('imagePlaceholder');
        if (this.files && this.files[0]) {
            preview.src = URL.createObjectURL(this.files[0]);
            preview.classList.remove('d-none');
            if (placeholder) placeholder.classList.add('d-none');
        }
    });
</script>