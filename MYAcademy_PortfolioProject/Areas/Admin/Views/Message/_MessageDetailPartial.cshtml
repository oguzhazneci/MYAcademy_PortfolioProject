@model Message

@* Modalın içine yerleşen parça. Layout yok; sadece bu HTML döner. *@
<div class="d-flex justify-content-between align-items-start gap-3 mb-3">
    <div>
        <div class="fw-bold fs-5">@Model.SenderName</div>
        <a href="mailto:@Model.SenderEmail" class="small text-muted">@Model.SenderEmail</a>
    </div>
    <span class="small text-muted text-nowrap">
        <i class="bi bi-clock me-1"></i>@Model.SendDate.ToString("dd.MM.yyyy HH:mm")
    </span>
</div>

<div class="mb-2">
    <span class="text-muted small">Konu</span>
    <div class="fw-semibold">@Model.Subject</div>
</div>

<hr />

@* white-space: pre-wrap → ziyaretçinin yazdığı satır sonları korunur (Html.Raw kullanmadan, güvenli şekilde). *@
<div style="white-space: pre-wrap; line-height: 1.7;">@Model.MessageDetail</div>

<div class="mt-4 pt-3 border-top">
    @* Yanıt, admin'in kendi e-posta uygulamasından gönderilir; konu satırı "Re: ..." olarak hazır gelir. *@
    <a href="mailto:@(Model.SenderEmail)?subject=@(Uri.EscapeDataString("Re: " + Model.Subject))" class="btn-pastel-primary text-decoration-none">
        <i class="bi bi-reply"></i>
        <span>E-posta ile Yanıtla</span>
    </a>
</div>