@model List<Experience>

@{
    ViewData["Title"] = "Deneyimlerim";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
}

<main class="page-content-area">

    <div class="content-header-row">
        <div>
            <h1 class="page-title">Deneyimlerim Listesi</h1>
            <p class="page-subtitle">Portfolyo sitenizde yer alacak deneyim içeriklerini buradan yönetebilirsiniz.</p>
        </div>
        <div class="header-actions">
            <a asp-action="CreateExperience" class="btn-pastel-primary text-decoration-none">
                <i class="bi bi-plus-circle-fill"></i>
                <span>Yeni Deneyim Ekle</span>
            </a>
        </div>
    </div>

    @* Şablondaki istatistik kartları korunuyor; sayılar artık sabit değil, gelen listeden hesaplanıyor. *@
    <div class="stats-row">
        <div class="stat-card">
            <div class="stat-icon-wrapper icon-green">
                <i class="bi bi-briefcase"></i>
            </div>
            <div class="stat-content">
                <span class="stat-label">Toplam Deneyim</span>
                <h3 class="stat-value">@Model.Count</h3>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon-wrapper icon-blue">
                <i class="bi bi-check2-circle"></i>
            </div>
            <div class="stat-content">
                <span class="stat-label">Aktif Kayıt</span>
                <h3 class="stat-value">@Model.Count(x => x.IsActive)</h3>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon-wrapper icon-beige">
                <i class="bi bi-pause-circle"></i>
            </div>
            <div class="stat-content">
                <span class="stat-label">Pasif Kayıt</span>
                <h3 class="stat-value">@Model.Count(x => !x.IsActive)</h3>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon-wrapper icon-purple">
                <i class="bi bi-hourglass-split"></i>
            </div>
            <div class="stat-content">
                <span class="stat-label">Devam Eden</span>
                <h3 class="stat-value">@Model.Count(x => x.EndDate == null)</h3>
            </div>
        </div>
    </div>

    <div class="data-table-card">
        <div class="table-responsive-wrapper">
            <table class="custom-admin-table">
                <thead>
                    <tr>
                        <th>Deneyim Başlığı</th>
                        <th>Kurum / Şirket</th>
                        <th>Çalışma Türü</th>
                        <th>Tarih Aralığı</th>
                        <th>Durum</th>
                        <th style="text-align: right;">İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center text-muted py-4">Henüz deneyim eklenmedi.</td>
                        </tr>
                    }

                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                <div class="experience-title-cell">
                                    <div class="exp-icon-bullet">
                                        <i class="bi bi-laptop"></i>
                                    </div>
                                    <span class="exp-title-text">@item.Title</span>
                                </div>
                            </td>
                            <td>
                                <div class="company-cell">
                                    <i class="bi bi-building company-badge-icon"></i>
                                    <span>@item.CompanyName</span>
                                </div>
                            </td>
                            <td><span class="work-type-badge">@item.CategoryName</span></td>
                            <td>
                                <span class="date-badge">
                                    <i class="bi bi-calendar2-range"></i>
                                    @item.DateRangeText
                                </span>
                            </td>
                            <td>
                                @if (item.IsActive)
                                {
                                    <span class="status-pill status-active">Aktif</span>
                                }
                                else
                                {
                                    <span class="status-pill status-passive">Pasif</span>
                                }
                            </td>
                            <td>
                                <div class="row-actions-group justify-content-end">
                                    <a asp-action="UpdateExperience" asp-route-id="@item.ExperienceId" class="btn-action-icon btn-edit" title="Güncelle">
                                        <i class="bi bi-pencil-square"></i>
                                    </a>

                                    <form asp-action="ToggleExperienceStatus" asp-route-id="@item.ExperienceId" method="post" class="d-inline">
                                        <button type="submit" class="btn-action-icon btn-view" title="@(item.IsActive ? "Pasife al" : "Aktif et")">
                                            <i class="bi @(item.IsActive ? "bi-eye-slash" : "bi-eye")"></i>
                                        </button>
                                    </form>

                                    @* Geçici onay: Aşama 9'da SweetAlert2 ile değiştirilecek. *@
                                    <form asp-action="DeleteExperience" asp-route-id="@item.ExperienceId" method="post" class="d-inline"
                                          data-confirm="Bu deneyimi silmek istediğinize emin misiniz?">
                                        <button type="submit" class="btn-action-icon btn-delete" title="Sil">
                                            <i class="bi bi-trash3"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

</main>