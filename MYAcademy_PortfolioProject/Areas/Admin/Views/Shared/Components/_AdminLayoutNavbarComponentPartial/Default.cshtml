@{
    bool hasUnread = ViewBag.HasUnread;
}

<header class="admin-navbar">
    <div class="navbar-left">
        <button class="sidebar-toggle-btn" id="sidebarToggle" aria-label="Menüyü Aç/Kapat">
            <i class="bi bi-list"></i>
        </button>
        @* Sayfa yolu: her view'ın kendi ViewData["Title"] değerinden gelir. *@
        <div class="breadcrumb-custom">
            <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index"><i class="bi bi-house me-1"></i> Gösterge Paneli</a>
            <span class="separator">/</span>
            <span class="active-crumb">@ViewData["Title"]</span>
        </div>
    </div>

    <div class="navbar-right">
        @* Hızlı arama: Gelen Kutusu'ndaki aramayı kullanır (7.1'deki ?search= parametresi). *@
        <form asp-area="Admin" asp-controller="Message" asp-action="MessageList" method="get" class="nav-search-box" role="search">
            <i class="bi bi-search"></i>
            <input type="search" name="search" placeholder="Mesajlarda ara..." aria-label="Mesajlarda ara">
        </form>

        <!-- Quick Action Button -->
        <a asp-area="Admin" asp-controller="Project" asp-action="CreateProject" class="btn-quick-add text-decoration-none">
            <i class="bi bi-plus-lg"></i>
            <span>Yeni Proje</span>
        </a>

        <!-- Notification Bell: okunmamış mesajlara gider -->
        <a asp-area="Admin" asp-controller="Message" asp-action="MessageList" asp-route-status="unread"
           class="icon-action-btn" title="@(hasUnread ? "Okunmamış mesajlarınız var" : "Okunmamış mesaj yok")">
            <i class="bi bi-bell"></i>
            @if (hasUnread)
            {
                <span class="notification-dot"></span>
            }
        </a>

        <!-- Messages -->
        <a asp-area="Admin" asp-controller="Message" asp-action="MessageList" class="icon-action-btn" title="Gelen Kutusu">
            <i class="bi bi-chat-left-text"></i>
        </a>

        <!-- Admin Profile Pill -->
        <div class="nav-profile-pill">
            <div class="nav-avatar-mini">AK</div>
            <span class="d-none d-sm-inline font-weight-600" style="font-size:0.825rem; font-weight:600;">Admin</span>
            <i class="bi bi-chevron-down text-muted" style="font-size: 0.7rem;"></i>
        </div>
    </div>
</header>