@{
    // Şu an açık olan sayfanın controller adı (örn: "Project")
    string currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";

    // Verilen controller'lardan biri açıksa "active" sınıfını döner.
    // Birden fazla ad alır: Projeler menüsü hem Project hem Category sayfalarında aktif görünsün.
    string ActiveIf(params string[] controllers) => controllers.Contains(currentController) ? "active" : "";

    int unreadCount = ViewBag.UnreadCount;
    string fullName = ViewBag.FullName;
    string initials = ViewBag.Initials;
}

<aside class="admin-sidebar" id="adminSidebar">
    <!-- Brand Header -->
    <div class="sidebar-header">
        <div class="brand-mark">
            <i class="bi bi-briefcase-fill"></i>
        </div>
        <div class="brand-text">
            <h1>@fullName</h1>
            <span>Yönetim Paneli</span>
        </div>
    </div>

    <!-- Menu Links -->
    <div class="sidebar-menu-wrapper">
        <div class="menu-section-label">Menü</div>
        <ul class="sidebar-nav">
            <li>
                <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index" class="sidebar-link @ActiveIf("Dashboard")">
                    <i class="bi bi-grid-1x2"></i>
                    <span>Gösterge Paneli</span>
                </a>
            </li>
            <li>
                <a asp-area="Admin" asp-controller="HeroSection" asp-action="UpdateHeroSection" class="sidebar-link @ActiveIf("HeroSection")">
                    <i class="bi bi-house"></i>
                    <span>Ana Sayfa</span>
                </a>
            </li>
            <li>
                <a asp-area="Admin" asp-controller="HeroTitle" asp-action="HeroTitleList" class="sidebar-link @ActiveIf("HeroTitle")">
                    <i class="bi bi-cursor-text"></i>
                    <span>Typewriter Yazıları</span>
                </a>
            </li>
            <li>
                <a asp-area="Admin" asp-controller="About" asp-action="UpdateAbout" class="sidebar-link @ActiveIf("About")">
                    <i class="bi bi-person"></i>
                    <span>Hakkımda</span>
                </a>
            </li>
            <li>
                <a asp-area="Admin" asp-controller="Skill" asp-action="SkillList" class="sidebar-link @ActiveIf("Skill", "SkillItem")">
                    <i class="bi bi-stars"></i>
                    <span>Yeteneklerim</span>
                </a>
            </li>
            <li>
                <a asp-area="Admin" asp-controller="Experience" asp-action="ExperienceList" class="sidebar-link @ActiveIf("Experience")">
                    <i class="bi bi-journal-bookmark-fill"></i>
                    <span>Deneyimlerim</span>
                </a>
            </li>
            <li>
                <a asp-area="Admin" asp-controller="Project" asp-action="ProjectList" class="sidebar-link @ActiveIf("Project", "Category")">
                    <i class="bi bi-code-slash"></i>
                    <span>Projelerim</span>
                </a>
            </li>
            <li>
                <a asp-area="Admin" asp-controller="Education" asp-action="EducationList" class="sidebar-link @ActiveIf("Education")">
                    <i class="bi bi-mortarboard"></i>
                    <span>Eğitim</span>
                </a>
            </li>
            <li>
                <a asp-area="Admin" asp-controller="Contact" asp-action="UpdateContact" class="sidebar-link @ActiveIf("Contact")">
                    <i class="bi bi-envelope"></i>
                    <span>İletişim</span>
                </a>
            </li>
            <li>
                <a asp-area="Admin" asp-controller="Message" asp-action="MessageList" class="sidebar-link @ActiveIf("Message")">
                    <i class="bi bi-inbox"></i>
                    <span>Gelen Kutusu</span>
                    @if (unreadCount > 0)
                    {
                        @* data-unread-count: mesaj modalla açılınca script bu sayıyı da günceller; sıfıra inince rozet kaldırılır. *@
                        <span class="badge-count" data-unread-count data-remove-when-zero title="Okunmamış mesaj">@unreadCount</span>
                    }
                </a>
            </li>
            <li>
                <a asp-area="Admin" asp-controller="SocialMedia" asp-action="SocialMediaList" class="sidebar-link @ActiveIf("SocialMedia")">
                    <i class="bi bi-share"></i>
                    <span>Sosyal Medya</span>
                </a>
            </li>
        </ul>

        <div class="menu-section-label mt-4">Sistem & Bağlantı</div>
                <ul class="sidebar-nav">
            <li>
                <a asp-area="" asp-controller="Default" asp-action="Index" target="_blank" rel="noopener" class="sidebar-link">
                    <i class="bi bi-box-arrow-up-right"></i>
                    <span>Siteyi Önizle</span>
                </a>
            </li>
            <li>
                @* Projenin herkese açık GitHub deposu: kodu inceleyen biri tek tıkla kaynağa ulaşsın *@
                <a href="https://github.com/oguzhazneci/MYAcademy_PortfolioProject" target="_blank" rel="noopener" class="sidebar-link">
                    <i class="bi bi-github"></i>
                    <span>Kaynak Kod (GitHub)</span>
                </a>
            </li>
        </ul>
    </div>

    <!-- Admin User / Logout Footer -->
    <div class="sidebar-footer">
        <div class="admin-user-card">
            <div class="user-avatar-circle">@initials</div>
            <div class="user-info">
                <div class="user-name">@fullName</div>
                @* User: giriş yapan kişi (10.1a'da çereze yazdığımız claim'lerden okunur) *@
                <div class="user-role">Yönetici · @User.Identity?.Name</div>
            </div>
            @* Çıkış durum değiştiren bir işlem → POST formu (form tag helper anti-forgery token'ı kendisi ekler) *@
            <form asp-area="Admin" asp-controller="Auth" asp-action="Logout" method="post" class="m-0">
                <button type="submit" class="btn-logout" title="Çıkış Yap" aria-label="Çıkış Yap">
                    <i class="bi bi-box-arrow-right"></i>
                </button>
            </form>
        </div>
    </div>
</aside>