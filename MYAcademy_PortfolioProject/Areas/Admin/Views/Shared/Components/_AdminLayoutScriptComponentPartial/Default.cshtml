<!-- Bootstrap 5 JS: modal, kapatılabilir uyarı (alert) gibi etkileşimli bileşenler için gerekli -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

<!-- SweetAlert2: onay ve bildirim pencereleri -->
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<!-- Ortak kullanıcı deneyimi davranışları (silme onayı vb.) -->
<script src="~/js/admin-ui.js" asp-append-version="true"></script>

<!-- Bütün admin sayfalarında ortak çalışan davranışlar -->
<script>
    // Mobilde sidebar'ı aç/kapat
    const sidebar = document.getElementById('adminSidebar');
    const sidebarToggle = document.getElementById('sidebarToggle');

    sidebarToggle.addEventListener('click', () => {
        sidebar.classList.toggle('show-sidebar');
    });

    // Mobilde sidebar dışına tıklanınca kapat
    document.addEventListener('click', (e) => {
        if (window.innerWidth <= 991.98) {
            if (!sidebar.contains(e.target) && !sidebarToggle.contains(e.target)) {
                sidebar.classList.remove('show-sidebar');
            }
        }
    });
</script>