@model List<SocialMedia>

@{
    ViewData["Title"] = "Sosyal Medya";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
}

<main class="page-content-area">

    <div class="content-header-row">
        <div>
            <h1 class="page-title">Sosyal Medya</h1>
            <p class="page-subtitle">Aktif bağlantılar sitede Ana Sayfa, İletişim ve Footer bölümlerinde bu sırayla görünür.</p>
        </div>
        <div class="header-actions">
            <a asp-action="CreateSocialMedia" class="btn-pastel-primary text-decoration-none">
                <i class="bi bi-plus-circle-fill"></i>
                <span>Yeni Bağlantı Ekle</span>
            </a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Kapat"></button>
        </div>
    }

    <div class="data-table-card">
        <div class="table-responsive-wrapper">
            <table class="custom-admin-table">
                <thead>
                    <tr>
                        <th>Sıra</th>
                        <th>Platform</th>
                        <th>Bağlantı</th>
                        <th>Durum</th>
                        <th style="text-align: right;">İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="5" class="text-center text-muted py-4">Henüz sosyal medya bağlantısı eklenmedi.</td>
                        </tr>
                    }

                    @foreach (var item in Model)
                    {
                        <tr>
                            <td><span class="order-badge">@item.Order</span></td>
                            <td class="fw-semibold"><i class="bi @item.IconClass me-2 fs-5"></i>@item.Name</td>
                            <td><a href="@item.Url" target="_blank" rel="noopener" class="small">@item.Url</a></td>
                            <td>
                                @if (item.IsActive)
                                {
                                    <span class="status-pill status-active">Aktif</span>
                                }
                                else
                                {
                                    <span class="status-pill status-passive">Pasif</span>
                                }
                            </td>
                            <td>
                                <div class="row-actions-group justify-content-end">
                                    <a asp-action="UpdateSocialMedia" asp-route-id="@item.SocialMediaId" class="btn-action-icon btn-edit" title="Güncelle">
                                        <i class="bi bi-pencil-square"></i>
                                    </a>

                                    <form asp-action="ToggleSocialMediaStatus" asp-route-id="@item.SocialMediaId" method="post" class="d-inline">
                                        <button type="submit" class="btn-action-icon btn-view" title="@(item.IsActive ? "Pasife al" : "Aktif et")">
                                            <i class="bi @(item.IsActive ? "bi-eye-slash" : "bi-eye")"></i>
                                        </button>
                                    </form>

                                    <form asp-action="DeleteSocialMedia" asp-route-id="@item.SocialMediaId" method="post" class="d-inline"
                                          onsubmit="return confirm('Bu bağlantıyı silmek istediğinize emin misiniz?');">
                                        <button type="submit" class="btn-action-icon btn-delete" title="Sil">
                                            <i class="bi bi-trash3"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

</main>