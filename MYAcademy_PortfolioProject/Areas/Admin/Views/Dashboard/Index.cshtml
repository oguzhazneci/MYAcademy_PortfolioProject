@model DashboardViewModel

@{
    ViewData["Title"] = "Gösterge Paneli";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";

    // İstatistik kartları: tek bir döngüyle çizilsin diye liste halinde.
    // Her kart, sayısının ait olduğu yönetim sayfasına link veriyor.
    var stats = new[]
    {
        (Val: Model.TotalProjectCount,  Lbl: "Toplam Proje",     Icon: "bi-code-slash",            Cls: "c-green",  Controller: "Project",    Action: "ProjectList"),
        (Val: Model.ActiveProjectCount, Lbl: "Aktif Proje",      Icon: "bi-check2-circle",         Cls: "c-blue",   Controller: "Project",    Action: "ProjectList"),
        (Val: Model.SkillCount,         Lbl: "Yetenek",          Icon: "bi-stars",                 Cls: "c-amber",  Controller: "SkillItem",  Action: "SkillItemList"),
        (Val: Model.ExperienceCount,    Lbl: "Deneyim",          Icon: "bi-briefcase",             Cls: "c-purple", Controller: "Experience", Action: "ExperienceList"),
        (Val: Model.EducationCount,     Lbl: "Eğitim",           Icon: "bi-mortarboard",           Cls: "c-green",  Controller: "Education",  Action: "EducationList"),
        (Val: Model.TotalMessageCount,  Lbl: "Toplam Mesaj",     Icon: "bi-envelope",              Cls: "c-blue",   Controller: "Message",    Action: "MessageList"),
        (Val: Model.UnreadMessageCount, Lbl: "Okunmamış Mesaj",  Icon: "bi-envelope-exclamation",  Cls: "c-rose",   Controller: "Message",    Action: "MessageList")
    };

    // Kategori grafiği: en yüksek çubuk %100 olacak şekilde oranlanır. (Max'ın 0 olmasına karşı en az 1)
    int maxProjectCount = Model.CategorySummary.Any() ? Model.CategorySummary.Max(x => x.ProjectCount) : 1;
}

<style>
    .db {
        --g: var(--accent-primary);
        --g-soft: var(--accent-primary-soft);
        --line: var(--border-color);
        --muted: var(--text-secondary);
    }

    .db-card {
        background: #fff;
        border: 1px solid var(--line);
        border-radius: 16px;
        padding: 1.4rem;
        height: 100%;
    }

    .db-title {
        font-weight: 600;
        margin-bottom: 1.2rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

        .db-title small {
            color: var(--muted);
            font-weight: 400;
        }

    .stat {
        display: flex;
        align-items: center;
        gap: 1rem;
    }

    .stat-icon {
        width: 52px;
        height: 52px;
        border-radius: 14px;
        display: grid;
        place-items: center;
        font-size: 1.4rem;
    }

    .stat-val {
        font-size: 1.8rem;
        font-weight: 700;
        line-height: 1;
    }

    .stat-lbl {
        color: var(--muted);
        font-size: .85rem;
        margin-top: .3rem;
    }

    .c-green {
        background: var(--g-soft);
        color: var(--g);
    }

    .c-blue {
        background: #e6eef8;
        color: #3b6ea5;
    }

    .c-rose {
        background: #f9e7e7;
        color: #b44b4b;
    }

    .bars {
        display: flex;
        align-items: flex-end;
        gap: .8rem;
        height: 190px;
    }

    .bar {
        flex: 1;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: flex-end;
        height: 100%;
        gap: .4rem;
    }

    .bar-fill {
        width: 100%;
        max-width: 42px;
        background: var(--g);
        border-radius: 8px 8px 4px 4px;
        opacity: .85;
        transition: opacity .2s;
    }

    .bar:hover .bar-fill {
        opacity: 1;
    }

    .bar span {
        font-size: .75rem;
        color: var(--muted);
    }

    .bar b {
        font-size: .8rem;
    }

    .donut {
        width: 150px;
        height: 150px;
        border-radius: 50%;
        margin: .5rem auto 1.2rem;
        display: grid;
        place-items: center;
        background: conic-gradient(var(--g) calc(var(--p) * 1%), var(--g-soft) 0);
    }

        .donut div {
            width: 110px;
            height: 110px;
            border-radius: 50%;
            background: #fff;
            display: grid;
            place-items: center;
            font-size: 1.6rem;
            font-weight: 700;
        }

    .legend {
        display: flex;
        justify-content: center;
        gap: 1.2rem;
        font-size: .85rem;
        color: var(--muted);
    }

        .legend i {
            display: inline-block;
            width: 10px;
            height: 10px;
            border-radius: 3px;
            margin-right: .35rem;
        }

    .msg-row {
        display: flex;
        align-items: center;
        gap: .9rem;
        padding: .8rem 0;
        border-bottom: 1px solid var(--line);
    }

        .msg-row:last-child {
            border-bottom: none;
        }

    .avatar {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        background: var(--g-soft);
        color: var(--g);
        display: grid;
        place-items: center;
        font-weight: 600;
        flex-shrink: 0;
    }

    .msg-body {
        flex: 1;
        min-width: 0;
    }

        .msg-body p {
            margin: 0;
            color: var(--muted);
            font-size: .85rem;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

    .badge-soft {
        font-size: .72rem;
        padding: .3rem .6rem;
        border-radius: 20px;
    }

    /* Aşama 8: eklenen renkler ve yardımcı sınıflar */
    .c-amber {
        background: #fbf0dc;
        color: #9a6a1c;
    }

    .c-purple {
        background: #efe8f6;
        color: #6b4c8f;
    }

    /* Tıklanabilir istatistik kartı: ilgili yönetim sayfasına götürür */
    a.db-card {
        color: inherit;
        text-decoration: none;
        transition: transform .15s, box-shadow .15s;
    }

        a.db-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 18px rgba(var(--accent-primary-rgb), .08);
        }

    .bar span {
        text-align: center;
        line-height: 1.2;
    }

    .project-mini-thumb {
        width: 56px;
        height: 40px;
        object-fit: cover;
        border-radius: 8px;
        border: 1px solid var(--line);
        flex-shrink: 0;
    }
</style>

<main class="page-content-area db">

    <!-- Başlık + Hızlı Erişim -->
    <div class="content-header-row">
        <div>
            <h1 class="page-title">Gösterge Paneli</h1>
            <p class="page-subtitle">Sitenizin güncel özeti · @DateTime.Now.ToString("dd MMMM yyyy, dddd", new System.Globalization.CultureInfo("tr-TR"))</p>
        </div>
        <div class="header-actions">
            <a asp-controller="Project" asp-action="CreateProject" class="btn-pastel-primary text-decoration-none">
                <i class="bi bi-plus-circle-fill"></i>
                <span>Yeni Proje Ekle</span>
            </a>
            <a asp-controller="Message" asp-action="MessageList" asp-route-status="unread" class="btn-pastel-secondary text-decoration-none">
                <i class="bi bi-inbox"></i>
                <span>Okunmamış Mesajlar (<span data-unread-count>@Model.UnreadMessageCount</span>)</span>
            </a>
        </div>
    </div>

    <!-- İstatistik kartları -->
    <div class="row row-cols-2 row-cols-md-3 row-cols-xl-4 g-3 mb-4">
        @foreach (var s in stats)
        {
            <div class="col">
                <a asp-controller="@s.Controller" asp-action="@s.Action" class="db-card stat">
                    <div class="stat-icon @s.Cls"><i class="bi @s.Icon"></i></div>
                    <div>
                        <div class="stat-val">@s.Val</div>
                        <div class="stat-lbl">@s.Lbl</div>
                    </div>
                </a>
            </div>
        }
    </div>

    <div class="row g-4 mb-4">
        <!-- Kategori özeti (GroupBy) -->
        <div class="col-xl-8">
            <div class="db-card">
                <div class="db-title">Kategorilere Göre Projeler <small>GroupBy ile hesaplanır</small></div>
                @if (!Model.CategorySummary.Any())
                {
                    <p class="text-muted small mb-0">Henüz proje eklenmedi.</p>
                }
                else
                {
                    <div class="bars">
                        @foreach (var c in Model.CategorySummary)
                        {
                            <div class="bar" title="@c.CategoryName: @c.ProjectCount proje">
                                <b>@c.ProjectCount</b>
                                <div class="bar-fill" style="height:@(c.ProjectCount * 100 / maxProjectCount)%"></div>
                                <span>@c.CategoryName</span>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>

        <!-- Okunma oranı -->
        <div class="col-xl-4">
            <div class="db-card">
                <div class="db-title">Mesaj Okunma Oranı</div>
                <div class="donut" style="--p:@Model.ReadRate"><div>%@Model.ReadRate</div></div>
                <div class="legend">
                    <span><i style="background:var(--g)"></i>Okundu (@(Model.TotalMessageCount - Model.UnreadMessageCount))</span>
                    <span><i style="background:var(--g-soft)"></i>Okunmadı (@Model.UnreadMessageCount)</span>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <!-- Son 5 mesaj -->
        <div class="col-xl-7">
            <div class="db-card">
                <div class="db-title">
                    Son Mesajlar
                    <a asp-controller="Message" asp-action="MessageList" class="small text-decoration-none" style="color:var(--g)">Tümünü gör →</a>
                </div>

                @if (!Model.LastMessages.Any())
                {
                    <p class="text-muted small mb-0">Henüz mesaj gelmedi.</p>
                }

                @foreach (var m in Model.LastMessages)
                {
                    <div class="msg-row" data-message-row data-unread="@(m.IsRead ? "false" : "true")">
                        <div class="avatar">@m.SenderName.Substring(0, 1).ToUpper()</div>
                        <div class="msg-body">
                            <strong>@m.SenderName</strong> · <span class="small">@m.Subject</span>
                            <p>@m.MessageDetail</p>
                        </div>
                        <small class="text-muted d-none d-md-block text-nowrap">@m.SendDate.ToString("dd.MM HH:mm")</small>
                        @if (m.IsRead)
                        {
                            <span class="badge-soft c-blue message-status-badge">Okundu</span>
                        }
                        else
                        {
                            <span class="badge-soft c-rose message-status-badge">Yeni</span>
                        }
                        <button type="button" class="btn-action-icon btn-edit btn-open-message" data-message-id="@m.MessageId" title="Mesajı oku">
                            <i class="bi bi-eye"></i>
                        </button>
                    </div>
                }
            </div>
        </div>

        <!-- Son eklenen 3 proje -->
        <div class="col-xl-5">
            <div class="db-card">
                <div class="db-title">
                    Son Eklenen Projeler
                    <a asp-controller="Project" asp-action="ProjectList" class="small text-decoration-none" style="color:var(--g)">Tümünü gör →</a>
                </div>

                @if (!Model.LastProjects.Any())
                {
                    <p class="text-muted small mb-0">Henüz proje eklenmedi.</p>
                }

                @foreach (var p in Model.LastProjects)
                {
                    <div class="msg-row">
                        @if (!string.IsNullOrEmpty(p.ImageUrl))
                        {
                            <img src="@p.ImageUrl" alt="@p.ProjectTitle" class="project-mini-thumb" />
                        }
                        else
                        {
                            <div class="avatar"><i class="bi bi-image"></i></div>
                        }
                        <div class="msg-body">
                            <a asp-controller="Project" asp-action="UpdateProject" asp-route-id="@p.ProjectId" class="fw-semibold text-dark text-decoration-none">@p.ProjectTitle</a>
                            <p>@p.Category?.CategoryName</p>
                        </div>
                        @if (p.IsActive)
                        {
                            <span class="badge-soft c-green">Aktif</span>
                        }
                        else
                        {
                            <span class="badge-soft c-rose">Pasif</span>
                        }
                    </div>
                }
            </div>
        </div>
    </div>

    @* Gelen Kutusu ile aynı modal ve aynı script *@
    <partial name="_MessageModalPartial" />

</main>

@section Scripts {
    <script src="~/js/admin-message-modal.js" asp-append-version="true"></script>
}