@model List<SkillItem>

@{
    ViewData["Title"] = "Yetenekler";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
}

<main class="page-content-area">

    <div class="content-header-row">
        <div>
            <h1 class="page-title">Yetenekler</h1>
            <p class="page-subtitle">Kategori kartlarının içinde görünen teknolojiler ve 0-100 arası seviyeleri.</p>
        </div>
        <div class="header-actions">
            <a asp-controller="Skill" asp-action="SkillList" class="btn-pastel-secondary text-decoration-none">
                <i class="bi bi-grid"></i>
                <span>Kategoriler</span>
            </a>
            <a asp-action="CreateSkillItem" class="btn-pastel-primary text-decoration-none">
                <i class="bi bi-plus-circle-fill"></i>
                <span>Yeni Yetenek Ekle</span>
            </a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Kapat"></button>
        </div>
    }

    <div class="data-table-card">
        <div class="table-responsive-wrapper">
            <table class="custom-admin-table">
                <thead>
                    <tr>
                        <th>Yetenek</th>
                        <th>Kategori</th>
                        <th style="width: 30%;">Seviye</th>
                        <th>İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="4" class="text-center text-muted py-4">Henüz yetenek eklenmedi.</td>
                        </tr>
                    }

                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="fw-semibold">@item.SkillItemTitle</td>
                            <td>
                                <i class="bi @item.Skill?.IconUrl me-1"></i>@item.Skill?.Title
                            </td>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <div class="progress flex-grow-1" style="height: 8px;" role="progressbar"
                                         aria-valuenow="@item.Level" aria-valuemin="0" aria-valuemax="100">
                                        <div class="progress-bar" style="width: @(item.Level)%; background-color: #91A99B;"></div>
                                    </div>
                                    <span class="small text-muted" style="min-width: 32px;">@item.Level</span>
                                </div>
                            </td>
                            <td>
                                <div class="row-actions-group">
                                    <a asp-action="UpdateSkillItem" asp-route-id="@item.SkillItemId" class="btn-action-icon btn-edit" title="Güncelle">
                                        <i class="bi bi-pencil"></i>
                                    </a>

                                    @* Geçici onay: Aşama 9'da SweetAlert2 ile değiştirilecek. *@
                                    <form asp-action="DeleteSkillItem" asp-route-id="@item.SkillItemId" method="post" class="d-inline"
                                          onsubmit="return confirm('Bu yeteneği silmek istediğinize emin misiniz?');">
                                        <button type="submit" class="btn-action-icon btn-delete" title="Sil">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

</main>