@model List<HeroTitle>

@{
    ViewData["Title"] = "Typewriter Yazıları";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
}

<main class="page-content-area">

    <div class="content-header-row">
        <div>
            <h1 class="page-title">Typewriter Yazıları</h1>
            <p class="page-subtitle">Ana sayfada başlığın altında sırayla yazılıp silinen ifadeler. Sadece aktif olanlar sitede görünür.</p>
        </div>
        <div class="header-actions">
            <a asp-action="CreateHeroTitle" class="btn-pastel-primary text-decoration-none">
                <i class="bi bi-plus-circle-fill"></i>
                <span>Yeni Yazı Ekle</span>
            </a>
        </div>
    </div>

    <div class="data-table-card">
        <div class="table-responsive-wrapper">
            <table class="custom-admin-table">
                <thead>
                    <tr>
                        <th>Sıra</th>
                        <th>Yazı</th>
                        <th>Durum</th>
                        <th>İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="4" class="text-center text-muted py-4">Henüz yazı eklenmedi.</td>
                        </tr>
                    }

                    @foreach (var item in Model)
                    {
                        <tr>
                            <td><span class="order-badge">@item.Order</span></td>
                            <td>@item.Title</td>
                            <td>
                                @if (item.IsActive)
                                {
                                    <span class="status-pill status-active">Aktif</span>
                                }
                                else
                                {
                                    <span class="status-pill status-passive">Pasif</span>
                                }
                            </td>
                            <td>
                                <div class="row-actions-group">
                                    <a asp-action="UpdateHeroTitle" asp-route-id="@item.HeroTitleId" class="btn-action-icon btn-edit" title="Güncelle">
                                        <i class="bi bi-pencil"></i>
                                    </a>

                                    <form asp-action="ToggleHeroTitleStatus" asp-route-id="@item.HeroTitleId" method="post" class="d-inline">
                                        <button type="submit" class="btn-action-icon btn-view" title="@(item.IsActive ? "Pasife al" : "Aktif et")">
                                            <i class="bi @(item.IsActive ? "bi-eye-slash" : "bi-eye")"></i>
                                        </button>
                                    </form>

                                    @* Geçici onay: Aşama 9'da SweetAlert2 ile değiştirilecek. *@
                                    <form asp-action="DeleteHeroTitle" asp-route-id="@item.HeroTitleId" method="post" class="d-inline"
                                          data-confirm="Bu yazıyı silmek istediğinize emin misiniz?">
                                        <button type="submit" class="btn-action-icon btn-delete" title="Sil">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

</main>