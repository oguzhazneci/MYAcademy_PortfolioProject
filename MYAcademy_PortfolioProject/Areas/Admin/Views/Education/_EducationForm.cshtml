@model Education

<form method="post">
    <input type="hidden" asp-for="EducationId" />

    <div class="row">
        <div class="col-md-4 mb-3">
            <label asp-for="DegreeType" class="form-label">Derece</label>
            <input asp-for="DegreeType" class="form-control" list="degreeTypes" placeholder="Seçin veya yazın" />
            <datalist id="degreeTypes">
                <option value="Lise"></option>
                <option value="Ön Lisans"></option>
                <option value="Lisans"></option>
                <option value="Yüksek Lisans"></option>
                <option value="Doktora"></option>
                <option value="Sertifika Programı"></option>
            </datalist>
            <span asp-validation-for="DegreeType" class="text-danger small"></span>
        </div>
        <div class="col-md-8 mb-3">
            <label asp-for="Department" class="form-label">Bölüm / Program</label>
            <input asp-for="Department" class="form-control" placeholder="Örn: Bilgisayar Mühendisliği" />
            <span asp-validation-for="Department" class="text-danger small"></span>
        </div>
    </div>

    <div class="mb-3">
        <label asp-for="SchoolName" class="form-label">Okul / Kurum</label>
        <input asp-for="SchoolName" class="form-control" />
        <span asp-validation-for="SchoolName" class="text-danger small"></span>
    </div>

    <div class="row">
        <div class="col-md-6 mb-3">
            <label asp-for="StartYear" class="form-label">Başlangıç Yılı</label>
            <input asp-for="StartYear" class="form-control" placeholder="Örn: 2017" />
            <span asp-validation-for="StartYear" class="text-danger small"></span>
        </div>
        <div class="col-md-6 mb-3">
            <label asp-for="EndYear" class="form-label">Bitiş Yılı</label>
            <input asp-for="EndYear" class="form-control" />
            <div class="form-text">Hâlâ devam ediyorsa boş bırakın.</div>
            <span asp-validation-for="EndYear" class="text-danger small"></span>
        </div>
    </div>

    <div class="mb-3">
        <label asp-for="Description" class="form-label">Açıklama <span class="text-muted">(isteğe bağlı)</span></label>
        <textarea asp-for="Description" class="form-control" rows="3"></textarea>
        <span asp-validation-for="Description" class="text-danger small"></span>
    </div>

    <div class="form-check form-switch mb-4">
        <input asp-for="IsActive" class="form-check-input" role="switch" />
        <label asp-for="IsActive" class="form-check-label">Aktif (sitede gösterilsin)</label>
    </div>

    <div class="d-flex gap-2">
        <button type="submit" class="btn-pastel-primary">
            <i class="bi bi-save"></i>
            <span>Kaydet</span>
        </button>
        <a asp-action="EducationList" class="btn-pastel-secondary text-decoration-none">
            <span>Vazgeç</span>
        </a>
    </div>
</form>