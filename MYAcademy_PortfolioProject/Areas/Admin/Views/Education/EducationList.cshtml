@model List<Education>

@{
    ViewData["Title"] = "Eğitim Bilgileri";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
}

<main class="page-content-area">

    <div class="content-header-row">
        <div>
            <h1 class="page-title">Eğitim Bilgileri</h1>
            <p class="page-subtitle">Sitedeki "Eğitim Hayatım" bölümünde yer alacak kayıtları buradan yönetebilirsiniz.</p>
        </div>
        <div class="header-actions">
            <a asp-action="CreateEducation" class="btn-pastel-primary text-decoration-none">
                <i class="bi bi-plus-circle-fill"></i>
                <span>Yeni Eğitim Ekle</span>
            </a>
        </div>
    </div>

    <div class="data-table-card">
        <div class="table-responsive-wrapper">
            <table class="custom-admin-table">
                <thead>
                    <tr>
                        <th>Derece / Bölüm</th>
                        <th>Okul / Kurum</th>
                        <th>Yıllar</th>
                        <th>Durum</th>
                        <th style="text-align: right;">İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="5" class="text-center text-muted py-4">Henüz eğitim bilgisi eklenmedi.</td>
                        </tr>
                    }

                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                <div class="experience-title-cell">
                                    <div class="exp-icon-bullet">
                                        <i class="bi bi-mortarboard"></i>
                                    </div>
                                    <div>
                                        <span class="exp-title-text">@item.Department</span>
                                        <small class="text-muted d-block">@item.DegreeType</small>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <div class="company-cell">
                                    <i class="bi bi-building company-badge-icon"></i>
                                    <span>@item.SchoolName</span>
                                </div>
                            </td>
                            <td>
                                <span class="date-badge">
                                    <i class="bi bi-calendar2-range"></i>
                                    @item.YearRangeText
                                </span>
                            </td>
                            <td>
                                @if (item.IsActive)
                                {
                                    <span class="status-pill status-active">Aktif</span>
                                }
                                else
                                {
                                    <span class="status-pill status-passive">Pasif</span>
                                }
                            </td>
                            <td>
                                <div class="row-actions-group justify-content-end">
                                    <a asp-action="UpdateEducation" asp-route-id="@item.EducationId" class="btn-action-icon btn-edit" title="Güncelle">
                                        <i class="bi bi-pencil-square"></i>
                                    </a>

                                    <form asp-action="ToggleEducationStatus" asp-route-id="@item.EducationId" method="post" class="d-inline">
                                        <button type="submit" class="btn-action-icon btn-view" title="@(item.IsActive ? "Pasife al" : "Aktif et")">
                                            <i class="bi @(item.IsActive ? "bi-eye-slash" : "bi-eye")"></i>
                                        </button>
                                    </form>

                                    <form asp-action="DeleteEducation" asp-route-id="@item.EducationId" method="post" class="d-inline"
                                          data-confirm="Bu eğitim bilgisini silmek istediğinize emin misiniz?">
                                        <button type="submit" class="btn-action-icon btn-delete" title="Sil">
                                            <i class="bi bi-trash3"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

</main>