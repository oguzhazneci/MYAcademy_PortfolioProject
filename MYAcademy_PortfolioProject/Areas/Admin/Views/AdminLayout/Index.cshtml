@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="tr">

@await Component.InvokeAsync("_AdminLayoutHeadComponentPartial")

<body>

    <div class="admin-wrapper">

        @await Component.InvokeAsync("_AdminLayoutSidebarComponentPartial")

        <div class="admin-main">

            @await Component.InvokeAsync("_AdminLayoutNavbarComponentPartial")

            @RenderBody()

        </div>
    </div>

    @* TempData bildirimleri: bütün admin sayfaları için tek merkez (script'lerden ÖNCE, ki admin-ui.js bulabilsin) *@
    <partial name="_NotificationPartial" />

    @await Component.InvokeAsync("_AdminLayoutScriptComponentPartial")

    @* Sayfaya özel script'ler buraya gelir: Bootstrap ve ortak script'lerden SONRA çalışırlar. *@
    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>