@model ProjectSectionViewModel

<!-- 8. Featured Projects Section -->
<section id="projects">
    <div class="container">
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-end mb-4 gap-3 reveal-on-scroll">
            <div>
                <div class="eyebrow-badge">
                    <i class="bi bi-folder-check"></i> SEÇİLMİŞ ÇALIŞMALAR
                </div>
                <h2 class="section-title mb-1">
                    Fikirden Ürüne Dönüşen Projeler
                </h2>
                <p class="section-description mb-0">
                    Öğrenme, üretme ve problem çözme süreçlerimin birer yansıması olan projelerimden bazıları.
                </p>
            </div>

            <!-- Filter Buttons: veritabanındaki kategorilerden üretilir -->
            <div class="d-flex flex-wrap gap-2" id="projectFilters">
                <button class="filter-btn active" data-filter="all">Tümü</button>
                @foreach (var category in Model.Categories)
                {
                    <button class="filter-btn" data-filter="cat-@category.CategoryId">@category.CategoryName</button>
                }
            </div>
        </div>

        <!-- Project Grid -->
        <div class="row g-4" id="projectGrid">
            @foreach (var item in Model.Projects)
            {
                // "ASP.NET Core, EF Core , SQL Server" → ["ASP.NET Core", "EF Core", "SQL Server"]
                var technologies = item.Technologies.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);

                <div class="col-lg-6 project-item reveal-on-scroll" data-category="cat-@item.CategoryId">
                    <div class="project-card">
                        <div class="project-thumb-wrap">
                            @if (!string.IsNullOrEmpty(item.ImageUrl))
                            {
                                <img src="@item.ImageUrl" alt="@item.ProjectTitle" class="project-thumb-img" loading="lazy">
                            }
                            else
                            {
                                <div class="w-100 h-100 d-flex align-items-center justify-content-center text-muted fs-1">
                                    <i class="bi bi-image"></i>
                                </div>
                            }
                            <span class="project-category-tag">@item.Category?.CategoryName</span>
                        </div>
                        <div class="project-body">
                            <h3 class="h4 fw-bold mb-2">@item.ProjectTitle</h3>
                            <p class="text-muted small mb-4 flex-grow-1">
                                @item.Description
                            </p>
                            <div class="mb-4">
                                @foreach (var tech in technologies)
                                {
                                    <span class="tech-badge">@tech</span>
                                }
                            </div>

                            @* Bağlantı yoksa alt şerit hiç gösterilmez: çalışmayan buton bırakmıyoruz. *@
                            @if (!string.IsNullOrEmpty(item.ProjectUrl))
                            {
                                <div class="d-flex align-items-center justify-content-between pt-3 border-top">
                                    <a href="@item.ProjectUrl" target="_blank" rel="noopener" class="btn-sage btn-sm">
                                        <span>Projeyi İncele</span>
                                        <i class="bi bi-arrow-up-right"></i>
                                    </a>
                                    @if (item.ProjectUrl.Contains("github.com"))
                                    {
                                        <span class="text-muted small"><i class="bi bi-github me-1"></i>Açık Kaynak</span>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>