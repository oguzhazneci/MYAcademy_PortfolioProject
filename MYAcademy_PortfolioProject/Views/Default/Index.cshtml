@model SendMessageViewModel

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="tr">
@await Component.InvokeAsync("_DefaultHeaderComponentPartial")
<body>

    @await Component.InvokeAsync("_DefaultNavbarComponentPartial")

    <main>
        @await Component.InvokeAsync("_DefaultHeroSectionComponentPartial")

        @await Component.InvokeAsync("_DefaultAboutComponentPartial")

        @await Component.InvokeAsync("_DefaultSkillComponentPartial")

        @await Component.InvokeAsync("_DefaultExperienceComponentPartial")

        @await Component.InvokeAsync("_DefaultProjectComponentPartial")

        @await Component.InvokeAsync("_DefaultEducationComponentPartial")

        <!-- 10. Personal Philosophy Section -->
        <section class="philosophy-section text-center">
            <div class="container">
                <div class="mx-auto reveal-on-scroll" style="max-width: 820px;">
                    <div class="mb-3 text-secondary" style="font-size: 2.5rem; line-height: 1;">
                        <i class="bi bi-code-slash text-light opacity-50"></i>
                    </div>
                    <p class="philosophy-quote mb-4">
                        "Kod yazmak bir araç; asıl iş, insanların gerçekten kullandığı bir ürünü ortaya koymak."
                    </p>
                    <div class="d-inline-flex align-items-center gap-2 text-white-50 small font-heading">
                        <span class="w-12 h-px bg-white-50"></span>
                        <span>Oğuz Hazneci — Yazılım Felsefesi</span>
                    </div>
                </div>
            </div>
        </section>

        <!-- 11. Contact Section -->
        <section id="contact">
            <div class="container">
                <div class="row gy-5">
                    @await Component.InvokeAsync("_DefaultContactInfoComponentPartial")

                    <!-- Right Column: Form -->
                    <div class="col-lg-7 ps-lg-5 reveal-on-scroll">
                        <div class="bg-white p-4 p-md-5 rounded-4 border shadow-sm">
                            @if (TempData["ContactSuccess"] != null)
                            {
                                <div class="alert alert-success d-flex align-items-center gap-2" role="alert">
                                    <i class="bi bi-check-circle-fill"></i>
                                    <span>@TempData["ContactSuccess"]</span>
                                </div>
                            }
                            
                            @if (TempData["ContactError"] != null)
                            {
                                @* Hız sınırı aşıldığında Program.cs'teki OnRejected bu mesajı yazar *@
                                <div class="alert alert-warning d-flex align-items-center gap-2" role="alert">
                                    <i class="bi bi-hourglass-split"></i>
                                    <span>@TempData["ContactError"]</span>
                                </div>
                            }

                            @* asp-controller/asp-action: form, Default controller'ındaki SendMessage (POST) action'ına gider.
   Form tag helper, CSRF koruması için gizli bir doğrulama anahtarını da otomatik ekler. *@
                            <form asp-controller="Default" asp-action="SendMessage" method="post" id="contactForm">
                                <div class="row g-3">
                                    <div class="col-md-6">
                                        <label asp-for="SenderName" class="form-label small fw-semibold">Adınız Soyadınız *</label>
                                        <input asp-for="SenderName" class="form-control form-control-custom" placeholder="Örn: Ahmet Yılmaz">
                                        <span asp-validation-for="SenderName" class="text-danger small"></span>
                                    </div>
                                    <div class="col-md-6">
                                        <label asp-for="SenderEmail" class="form-label small fw-semibold">E-posta Adresiniz *</label>
                                        <input asp-for="SenderEmail" class="form-control form-control-custom" placeholder="ad@ornek.com">
                                        <span asp-validation-for="SenderEmail" class="text-danger small"></span>
                                    </div>
                                    <div class="col-12">
                                        <label asp-for="Subject" class="form-label small fw-semibold">Konu</label>
                                        <input asp-for="Subject" class="form-control form-control-custom" placeholder="Örn: İş teklifi, proje iş birliği">
                                        <span asp-validation-for="Subject" class="text-danger small"></span>
                                    </div>
                                    <div class="col-12">
                                        <label asp-for="MessageDetail" class="form-label small fw-semibold">Mesajınız *</label>
                                        <textarea asp-for="MessageDetail" class="form-control form-control-custom" rows="5" placeholder="Projeniz veya sorunuz hakkında detayları paylaşın..."></textarea>
                                        <span asp-validation-for="MessageDetail" class="text-danger small"></span>
                                    </div>
                                    @* Honeypot: insanlar görmez (ekran dışında), klavyeyle de ulaşamaz (tabindex="-1"), ekran okuyucular atlar (aria-hidden).
                                       display:none KULLANMIYORUZ: bazı botlar gizlenmiş alanları tanıyıp boş bırakır. *@
                                    <div class="hp-field" aria-hidden="true">
                                        <label asp-for="Website">Web siteniz (bu alanı boş bırakın)</label>
                                        <input asp-for="Website" tabindex="-1" autocomplete="off" />
                                    </div>
                                    <div class="col-12 pt-2">
                                        <button type="submit" class="btn-sage w-100 justify-content-center py-3 fs-6">
                                            <i class="bi bi-send-fill"></i>
                                            <span>Mesajımı Gönder</span>
                                        </button>
                                        <div class="text-muted text-center small mt-3" style="font-size: 0.78rem;">
                                            <i class="bi bi-shield-check me-1"></i> Gönderilen bilgiler gizlilik ilkeleri doğrultusunda korunmaktadır.
                                        </div>
                                    </div>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </main>

    @await Component.InvokeAsync("_DefaultFooterComponentPartial")

    <!-- Bootstrap 5 JS Bundle -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

    <!-- Vanilla JavaScript for Interactivity -->
    <script>
            // 1. Typewriter Animation for Hero Section
            (function initTypewriter() {
                const targetElement = document.getElementById("typewriterText");
                if (!targetElement) return;

                // Yazılar artık sabit dizi yerine, sunucunun data-phrases attribute'una yazdığı JSON'dan okunuyor.
                const phrases = JSON.parse(targetElement.dataset.phrases);

                let phraseIndex = 0;
                let charIndex = 0;
                let isDeleting = false;
                const typeSpeed = 80;
                const deleteSpeed = 40;
                const delayBetween = 1800;

                function typeCycle() {
                    const currentPhrase = phrases[phraseIndex];
                    if (isDeleting) {
                        targetElement.textContent = currentPhrase.substring(0, charIndex - 1);
                        charIndex--;
                    } else {
                        targetElement.textContent = currentPhrase.substring(0, charIndex + 1);
                        charIndex++;
                    }

                    if (!isDeleting && charIndex === currentPhrase.length) {
                        setTimeout(() => {
                            isDeleting = true;
                            typeCycle();
                        }, delayBetween);
                        return;
                    } else if (isDeleting && charIndex === 0) {
                        isDeleting = false;
                        phraseIndex = (phraseIndex + 1) % phrases.length;
                        setTimeout(typeCycle, 300);
                        return;
                    }

                    setTimeout(typeCycle, isDeleting ? deleteSpeed : typeSpeed);
                }

                typeCycle();
            })();

            // 2. Fixed Navbar on Scroll
            window.addEventListener("scroll", function () {
                const navbar = document.getElementById("mainNavbar");
                if (window.scrollY > 40) {
                    navbar.classList.add("scrolled");
                } else {
                    navbar.classList.remove("scrolled");
                }
            });

            // 3. Active Nav Link on Scroll Spy
            const sections = document.querySelectorAll("section[id]");
            const navLinks = document.querySelectorAll(".nav-link-custom");

            function updateActiveNav() {
                const scrollY = window.pageYOffset;
                sections.forEach(current => {
                    const sectionHeight = current.offsetHeight;
                    const sectionTop = current.offsetTop - 120;
                    const sectionId = current.getAttribute("id");

                    if (scrollY > sectionTop && scrollY <= sectionTop + sectionHeight) {
                        navLinks.forEach(link => {
                            link.classList.remove("active");
                            if (link.getAttribute("href") === "#" + sectionId) {
                                link.classList.add("active");
                            }
                        });
                    }
                });
            }
            window.addEventListener("scroll", updateActiveNav);

            // 4. Mobile Menu Auto-close on click
            document.querySelectorAll(".mobile-nav-link").forEach(link => {
                link.addEventListener("click", () => {
                    const mobileMenu = document.getElementById("mobileMenu");
                    if (mobileMenu && mobileMenu.classList.contains("show")) {
                        const bsCollapse = bootstrap.Collapse.getInstance(mobileMenu);
                        if (bsCollapse) bsCollapse.hide();
                    }
                });
            });

            // 5. Project Filtering (Vanilla JS)
            const filterButtons = document.querySelectorAll("#projectFilters .filter-btn");
            const projectItems = document.querySelectorAll("#projectGrid .project-item");

            filterButtons.forEach(btn => {
                btn.addEventListener("click", () => {
                    filterButtons.forEach(b => b.classList.remove("active"));
                    btn.classList.add("active");

                    const filterValue = btn.getAttribute("data-filter");
                    projectItems.forEach(item => {
                        const categories = (item.getAttribute("data-category") || "").split(" ");
                        if (filterValue === "all" || categories.includes(filterValue)) {
                            item.style.display = "block";
                            item.style.opacity = "1";
                        } else {
                            item.style.display = "none";
                            item.style.opacity = "0";
                        }
                    });
                });
            });

            // 6. Back to Top Button
            const backToTopBtn = document.getElementById("backToTop");
            if (backToTopBtn) {
                backToTopBtn.addEventListener("click", () => {
                    window.scrollTo({ top: 0, behavior: "smooth" });
                });
            }

            // 7. Intersection Observer for Scroll Reveals
            const revealElements = document.querySelectorAll(".reveal-on-scroll");
            const observer = new IntersectionObserver((entries) => {
                entries.forEach(entry => {
                    if (entry.isIntersecting) {
                        entry.target.classList.add("is-revealed");
                        observer.unobserve(entry.target);
                    }
                });
            }, {
                threshold: 0.1,
                rootMargin: "0px 0px -40px 0px"
            });

            revealElements.forEach(el => observer.observe(el));
    </script>

    @* Form hatalarla geri döndüyse sayfa en üstten açılır; ziyaretçiyi doğrudan forma götürüyoruz. *@
    @if (!ViewData.ModelState.IsValid)
    {
        <script>
                document.getElementById('contact').scrollIntoView();
        </script>
    }
</body>
</html>